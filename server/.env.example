# Copiez ce fichier vers .env puis remplissez vos valeurs.
# Le fichier .env ne doit JAMAIS être commité.

# --- IA ---
MISTRAL_API_KEY=cle_mistral
GROQ_API_KEY=cle_groq
TRYIA_API_URL=https://...

# --- Serveur ---
PORT=4000
NODE_ENV=development
WEB_CONCURRENCY=2
TRUST_PROXY=true
REQUEST_TIMEOUT_MS=65000
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=20
RATE_LIMIT_STRICT_MAX=10
RATE_LIMIT_HEAVY_MAX=5

# --- Firebase ---
# Locale : chemin vers le JSON du compte de service
GOOGLE_APPLICATION_CREDENTIALS=../muslim-ia-firebase-adminsdk-xxx.json
# Hébergé (Render/Vercel) : contenu JSON complet dans une variable
FIREBASE_PROJECT_ID=muslim-ia
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account", ...}

# --- Email (Brevo) ---
BREVO_API_KEY=cle_brevo
BREVO_SENDER_NAME=Muslim IA
BREVO_SENDER_EMAIL=contact@exemple.com
PUBLIC_LOGO_URL=https://...
AUTH_CONTINUE_URL=https://...

# --- Audio ---
MISTRAL_VOICE_ID=

# --- Paiement (GeniusPay) ---
GENIUSPAY_API_KEY=pk_live_xxx
GENIUSPAY_API_SECRET=sk_live_xxx
GENIUSPAY_BASE_URL=https://pay.genius.ci/api/v1/merchant
GENIUSPAY_SANDBOX=false
PAYMENT_SUCCESS_URL=https://muslim-ia.web.app/payment/success
PAYMENT_ERROR_URL=https://muslim-ia.web.app/payment/error
